# The CutList environment example.
# Copy this file to .env.local for local development. Never commit .env.local.
#
# Development builds of the desktop app (`npm run dev`) read .env.local from the project
# root and pass it to the trusted backend; a variable already set in the launching shell
# wins. The prompt harness reads it too. Packaged builds ignore this file entirely and
# take their configuration from the in-app LLM setup dialog and the OS keychain.

# Server-only. Allowed values: ollama, openai, gemini, none.
LLM_PROVIDER=gemini

# Server-only. Used only when LLM_PROVIDER=ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=granite4.1:8b
# Server-only. Used only for Ollama gpt-oss models. Allowed values: low, medium, high.
OLLAMA_GPT_OSS_THINK=medium

# Server-only. Used only when LLM_PROVIDER=openai.
# Use a real key only in your shell environment, .env.local, or deployment secrets, never in source control.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Server-only. Used only when LLM_PROVIDER=gemini.
# If GEMINI_API_KEY is exported in your shell, .env.local can omit this value.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server-only. Optional request timeout for LLM calls.
LLM_TIMEOUT_MS=120000

# Deprecated fallback only. Use the in-app Curator persona control instead.
# Allowed legacy values: sharp, classic, critic.
LLM_CURATOR_VOICE=

# Server-only. Set to 1 only while debugging locally; raw model output can include user text.
LLM_DEBUG_RAW=0

# Local-only. Set to 1 to print Tauri/backend/provider/LLM timing logs to stderr.
CUTLIST_DEBUG_TIMING=0

# --- Debug and development-only variables ---------------------------------------------
# Every variable the TypeScript code reads is listed in this file; src/envVariables.test.ts
# fails when one is missing. These stay unset in normal use.

# Local-only. Set to 1 to print request-routing traces (stage, route family, plan) to the
# console. NEXT_PUBLIC_ form applies to the webview, plain form to the backend.
# CUTLIST_DEBUG_REVIEW_ROUTING=0
# NEXT_PUBLIC_CUTLIST_DEBUG_REVIEW_ROUTING=0

# Backend-only. Override the LLM request budget (requests per minute) the backend enforces
# per process, and print a line when a request has to wait for the window.
# LLM_REQUESTS_PER_MINUTE=15
# LLM_TEST_REQUESTS_PER_MINUTE=
# LLM_RATE_LIMIT_PROGRESS=0

# Backend-only. Point the Gemini client at a different API host, for proxies or tests.
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Set by the Rust shell on the backend child; never set these by hand.
# CUTLIST_APP_VERSION=        package.json version, used in the MusicBrainz User-Agent
# CUTLIST_DESKTOP_DATA_DIR=   app-data directory for the settings and workspace files
# CUTLIST_TIMING_ID=          correlates timing log lines for one command
# CUTLIST_GEMINI_KEY_SOURCE=  marks GEMINI_API_KEY as injected from the keychain rather than the shell
# CUTLIST_OPENAI_KEY_SOURCE=  same marker for OPENAI_API_KEY

# Test and harness overrides for the app-data file locations.
# CUTLIST_LLM_SETTINGS_PATH=
# CUTLIST_DESKTOP_WORKSPACE_STATE_PATH=

# Prompt harness (npm run prompt:harness) and cross-cutting eval (npm run eval:cross-cutting).
# PROMPT_HARNESS_FIXTURE=          run one fixture by id
# PROMPT_HARNESS_DEBUG_RAW=0       print raw model output for the harness only
# CROSS_CUTTING_EVAL_FIXTURE=      run one fixture by id
# CROSS_CUTTING_EVAL_DETERMINISTIC=0
# CROSS_CUTTING_EVAL_STRICT=0      fail the run on low scores instead of reporting them
# CROSS_CUTTING_EVAL_MARKDOWN=     write the scorecard to this markdown file
